# One unit for every agent on the machine: tomte@<name> runs
# /srv/tomte/<name>/<name> with the variables in /srv/tomte/<name>/env.
# `tomte setup` installs it and `tomte deploy` starts agents with it.
#
#   journalctl -u tomte@hn-digest -f
#
# The run log is /var/lib/tomte/<name>/<name>.jsonl.

[Unit]
Description=Tomte agent %i
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/srv/tomte/%i/%i serve
EnvironmentFile=/srv/tomte/%i/env
Restart=on-failure
RestartSec=10s
# Runs in progress get 60 s to finish after a stop.
TimeoutStopSec=90s

# Its own throwaway user, a private state directory and nothing else.
# `tomte-helper run` starts one-off runs with the same settings; change
# them there too.
# Without User=, every agent would get the same user, named "tomte".
# An agent built with tomte.ReadsJournal also gets the systemd-journal
# group, from a drop-in tomte-helper writes in tomte@<name>.service.d.
DynamicUser=yes
User=tomte-%i
StateDirectory=tomte/%i
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
# And none of the kernel, other processes or root's powers: an agent is
# a Go program that talks to the network and writes its state directory.
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

# Keeps one agent from starving the others; tomte.slice keeps all of
# them together from starving the rest of the machine.
Slice=tomte.slice
MemoryMax=128M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
