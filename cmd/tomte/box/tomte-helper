#!/bin/sh
# tomte-helper is what the tomte command does on this machine, as root.
# `tomte setup` installs it and lets the ssh user run it with sudo and no
# password, and nothing else, so it takes only agent names and touches
# only tomte@<name> (and its drop-in directory), /srv/tomte/<name> and
# /var/lib/tomte/<name> (which systemd keeps in /var/lib/private/tomte/<name>).
#
#   tomte-helper stage <id>           an agent binary on stdin; prints its info
#   tomte-helper env <name>           the agent's env file on stdin
#   tomte-helper getenv <name>        print the agent's env file
#   tomte-helper activate <id> <name> put the staged binary in place, (re)start it
#                                     and print its info, with its env file
#   tomte-helper restart <name>       restart the agent
#   tomte-helper ls                   every agent: its unit, info and today's runs
#   tomte-helper logs <name> <lines> [follow]  the agent's journal
#   tomte-helper runs <name> <count>  the last lines of its run log
#   tomte-helper run <name> <task>    do one task now, as the agent
#   tomte-helper rollback <name>      swap the binary with the one before, restart
#                                     and print its info
#   tomte-helper rm <name> [purge]    stop and remove the agent; purge: its run log too
set -eu
umask 022

root=/srv/tomte
state=/var/lib/tomte
private=/var/lib/private/tomte
units=/etc/systemd/system
incoming=$root/.incoming

die() {
	echo "tomte-helper: $*" >&2
	exit 1
}

valid_name() {
	# Spelled out: what a-z matches depends on the locale.
	case $1 in
	'' | -* | *[!abcdefghijklmnopqrstuvwxyz0123456789-]*) return 1 ;;
	esac
	[ ${#1} -le 25 ]
}

check_name() {
	valid_name "$1" || die "bad agent name \"$1\": use up to 25 lowercase letters, digits and dashes"
}

check_agent() {
	check_name "$1"
	[ -x "$root/$1/$1" ] || die "there's no agent named $1 here"
}

check_count() {
	case $1 in
	'' | *[!0-9]*) die "bad count \"$1\"" ;;
	esac
}

check_id() {
	case $1 in
	'' | *[!0-9a-f]*) die "bad upload id \"$1\"" ;;
	esac
}

# limits keep a binary that hangs or grows while describing itself, or
# while its log is read, from holding up the tomte command or the machine.
limits='-p RuntimeMaxSec=30 -p MemoryMax=128M -p CPUQuota=50% -p Slice=tomte.slice'

# describe runs `<binary> info` the way the service runs the agent, but
# without a network.
describe() { # binary [env file]
	# shellcheck disable=SC2086 # $limits is several words
	systemd-run --quiet --wait --pipe --collect $limits \
		-p DynamicUser=yes -p PrivateNetwork=yes -p ProtectSystem=strict -p ProtectHome=yes \
		${2:+-p EnvironmentFile=-$2} "$1" info </dev/null
}

# as_agent runs a command as the agent's own user, with its state
# directory and without a network. The run log is the agent's to write,
# so it's read this way: as root, a symlink in it could reach any file.
as_agent() { # name [systemd-run options] command...
	n=$1
	shift
	# shellcheck disable=SC2086 # $limits is several words
	systemd-run --quiet --wait --pipe --collect $limits \
		-p DynamicUser=yes -p User="tomte-$n" -p StateDirectory="tomte/$n" \
		-p PrivateNetwork=yes -p ProtectSystem=strict -p ProtectHome=yes -p PrivateTmp=yes \
		"$@" </dev/null
}

stage() {
	check_id "$1"
	mkdir -p "$incoming"
	find "$incoming" -type f -mmin +60 -delete
	f=$incoming/$1
	cat >"$f"
	chmod 755 "$f"
	describe "$f" || {
		rm -f "$f"
		die "the binary didn't describe itself; is it a tomte agent, built with a tomte that has \`info\`?"
	}
}

# access gives the agent's user the systemd-journal group, with a drop-in
# for its unit, when the binary's info says "journal":true
# (tomte.ReadsJournal), and takes it away when it doesn't. It's the only
# access an agent can ask for.
access() { # name binary
	dropin=$units/tomte@$1.service.d
	if describe "$2" 2>/dev/null | grep -qF '"journal":true'; then
		mkdir -p "$dropin"
		printf '[Service]\nSupplementaryGroups=systemd-journal\n' >"$dropin/journal.conf"
	else
		rm -f "$dropin/journal.conf"
		rmdir "$dropin" 2>/dev/null || true
	fi
	systemctl daemon-reload
}

reads_journal() {
	[ -e "$units/tomte@$1.service.d/journal.conf" ]
}

set_env() {
	check_name "$1"
	mkdir -p "$root/$1"
	(
		umask 077
		cat >"$root/$1/env.new"
	)
	mv "$root/$1/env.new" "$root/$1/env"
}

activate() {
	check_id "$1"
	check_name "$2"
	f=$incoming/$1
	d=$root/$2
	unit=tomte@$2
	[ -f "$f" ] || die "nothing uploaded as $1"
	mkdir -p "$d"
	if [ ! -e "$d/env" ]; then
		(
			umask 077
			: >"$d/env"
		)
	fi
	if [ -e "$d/$2" ]; then
		mv "$d/$2" "$d/$2.prev"
	fi
	mv "$f" "$d/$2"
	access "$2" "$d/$2"
	systemctl enable --quiet "$unit"
	restart "$2"
	# Its schedules follow the TZ in the env file, which stage couldn't use.
	describe "$d/$2" "$d/env" || true
}

restart() {
	check_agent "$1"
	systemctl restart "tomte@$1"
	# An agent that can't start fails within a second or two.
	sleep 3
	if ! systemctl is-active --quiet "tomte@$1"; then
		echo "tomte@$1 isn't running:" >&2
		journalctl -u "tomte@$1" -n 20 --no-pager -o cat >&2 || true
		exit 1
	fi
}

get_env() {
	check_agent "$1"
	cat "$root/$1/env"
}

logs() {
	check_name "$1"
	check_count "$2"
	if [ "${3-}" = follow ]; then
		exec journalctl -u "tomte@$1" -n "$2" -o short-iso -f
	fi
	exec journalctl -u "tomte@$1" -n "$2" -o short-iso --no-pager
}

runs() {
	check_name "$1"
	check_count "$2"
	# A log stays after its agent is removed; one that never ran has none.
	[ -d "$state/$1" ] || return 0
	# shellcheck disable=SC2016 # the inner shell expands them
	as_agent "$1" /bin/sh -c '[ ! -e "$1" ] || tail -n "$2" "$1"' sh "$state/$1/$1.jsonl" "$2"
}

# run does one task the way the service would: as the agent's own user,
# who owns its state directory, and inside the same limits as the unit.
run() {
	check_agent "$1"
	[ -n "$2" ] || die "no task"
	groups=
	if reads_journal "$1"; then
		groups=systemd-journal
	fi
	exec systemd-run --quiet --wait --pipe --collect \
		-p DynamicUser=yes -p User="tomte-$1" -p StateDirectory="tomte/$1" \
		${groups:+-p SupplementaryGroups=$groups} \
		-p EnvironmentFile="$root/$1/env" -p Slice=tomte.slice \
		-p ProtectSystem=strict -p ProtectHome=yes -p PrivateTmp=yes -p PrivateDevices=yes \
		-p NoNewPrivileges=yes -p MemoryMax=128M -p CPUQuota=50% \
		-p CapabilityBoundingSet= -p "RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX" \
		-p RestrictNamespaces=yes -p RestrictRealtime=yes -p LockPersonality=yes \
		-p MemoryDenyWriteExecute=yes -p ProtectKernelTunables=yes -p ProtectKernelModules=yes \
		-p ProtectKernelLogs=yes -p ProtectControlGroups=yes -p ProtectClock=yes \
		-p ProtectHostname=yes -p ProtectProc=invisible -p SystemCallArchitectures=native \
		-p SystemCallFilter=@system-service -p SystemCallErrorNumber=EPERM -p UMask=0077 \
		"$root/$1/$1" run "$2" </dev/null
}

# rollback swaps rather than overwrites, so a second rollback goes back
# to where the first started.
rollback() {
	check_agent "$1"
	d=$root/$1
	[ -x "$d/$1.prev" ] || die "$1 has no previous binary to go back to"
	mv "$d/$1" "$d/$1.next"
	mv "$d/$1.prev" "$d/$1"
	mv "$d/$1.next" "$d/$1.prev"
	access "$1" "$d/$1"
	restart "$1"
	describe "$d/$1" "$d/env" || true
}

remove() {
	check_name "$1"
	[ -d "$root/$1" ] || die "there's no agent named $1 here"
	systemctl disable --now --quiet "tomte@$1" || true
	systemctl reset-failed "tomte@$1" 2>/dev/null || true
	rm -rf "${root:?}/$1"
	if reads_journal "$1"; then
		rm -f "$units/tomte@$1.service.d/journal.conf"
		rmdir "$units/tomte@$1.service.d" 2>/dev/null || true
		systemctl daemon-reload
	fi
	if [ "${2-}" = purge ]; then
		rm -rf "${private:?}/$1" "${state:?}/$1"
	fi
}

list() {
	echo "now $(date +%s)"
	for d in "$root"/*/; do
		[ -d "$d" ] || continue
		n=$(basename "$d")
		if ! valid_name "$n" || [ ! -x "$d$n" ]; then
			continue
		fi
		echo "agent $n"
		systemctl show "tomte@$n" --timestamp=unix \
			-p ActiveState -p SubState -p MemoryCurrent -p ActiveEnterTimestamp | sed 's/^/show /'
		# One unit per agent describes it and reads its log. Its env
		# file's TZ, which its run log's times are in, says when today is.
		# shellcheck disable=SC2016 # the inner shell expands them
		as_agent "$n" -p EnvironmentFile=-"${d}env" /bin/sh -c '
			if i=$("$1" info 2>/dev/null); then echo "info $i"; fi
			[ -e "$2" ] || exit 0
			grep -F "\"start\":\"$(date +%F)" "$2" | sed "s/^/today /" || true
			tail -n 1 "$2" | sed "s/^/last /"' sh "$d$n" "$state/$n/$n.jsonl" 2>/dev/null || true
	done
}

case ${1-} in
stage) [ $# -eq 2 ] || die "usage: stage <id>" && stage "$2" ;;
env) [ $# -eq 2 ] || die "usage: env <name>" && set_env "$2" ;;
getenv) [ $# -eq 2 ] || die "usage: getenv <name>" && get_env "$2" ;;
activate) [ $# -eq 3 ] || die "usage: activate <id> <name>" && activate "$2" "$3" ;;
restart) [ $# -eq 2 ] || die "usage: restart <name>" && restart "$2" ;;
ls) [ $# -eq 1 ] || die "usage: ls" && list ;;
logs) [ $# -eq 3 ] || [ $# -eq 4 ] || die "usage: logs <name> <lines> [follow]" && logs "$2" "$3" "${4-}" ;;
runs) [ $# -eq 3 ] || die "usage: runs <name> <count>" && runs "$2" "$3" ;;
run) [ $# -eq 3 ] || die "usage: run <name> <task>" && run "$2" "$3" ;;
rollback) [ $# -eq 2 ] || die "usage: rollback <name>" && rollback "$2" ;;
rm) [ $# -eq 2 ] || [ $# -eq 3 ] || die "usage: rm <name> [purge]" && remove "$2" "${3-}" ;;
*) die "unknown command \"${1-}\"; this helper may be older than the tomte command" ;;
esac
